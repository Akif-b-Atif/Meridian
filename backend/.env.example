# Copy to .env for local development. Production values are set in the Render dashboard.
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173
# Required when APP_ENV=production: a URL or email that identifies this project to providers.
CONTACT_URL=https://github.com/your-name/meridian
# Optional. Without these the cache runs in memory only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Set to floored if the Open-Meteo calibration says so.
OM_WEIGHT_MODEL=fractional
